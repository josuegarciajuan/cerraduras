# WS-VB6 environment example (copy to .env and adjust)

APP_ENV=dev
APP_NAME=ws-vb6
APP_TZ=Europe/Madrid
APP_DEBUG=true

# --- HTTP ---
APP_HTTP_HOST=127.0.0.1
APP_HTTP_PORT=8081

# --- VB6 database (read/write limited) ---
VB6_DB_HOST=80.28.208.122
VB6_DB_PORT=3306
VB6_DB_NAME=bs2026
VB6_DB_USER=change_me
VB6_DB_PASS=change_me

# --- Auxiliary database (idempotency, NOT inside bs2026) ---
AUX_DB_HOST=127.0.0.1
AUX_DB_PORT=3306
AUX_DB_NAME=ws_vb6_aux
AUX_DB_USER=ws_vb6_aux
AUX_DB_PASS=change_me

# --- Security ---
# SHA-256 hex of the API key that the main API uses to call this service.
WS_API_KEY_HASH=change_me_sha256_hex_of_expected_api_key

# --- Behaviour / Pricing (P4) ---
# Optional overrides; if empty, catalog is auto-resolved.
APP_PRICING_CODART_HOUR=
APP_PRICING_CODART_HALFHOUR=
# A_FAIR or B_LITERAL
APP_PRICING_ROUNDING=A_FAIR

# --- Behaviour / Logging in VB6 (P2) ---
# rfid value written into bs2026.log_usuarios for this system (<=10 chars)
APP_VB6_SYSTEM_RFID=QRSYS

# --- Temporada fallback strategy (S22) ---
# LOTE_ACTIVO or YEAR_NOW
APP_TEMPORADA_FALLBACK_STRATEGY=LOTE_ACTIVO

# --- Logging ---
LOG_PATH=logs/ws-vb6.log
LOG_LEVEL=debug
