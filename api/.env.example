# API environment example (copy to .env and adjust)

APP_ENV=dev
APP_NAME=api
APP_TZ=Europe/Madrid
APP_DEBUG=false

# --- HTTP ---
APP_HTTP_HOST=127.0.0.1
APP_HTTP_PORT=8080

# --- Database (API own schema) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hotel_api
DB_USER=hotel_api
DB_PASS=change_me

# --- Security ---
# HMAC secret for QR tokens (>=32 bytes, base64 or hex recommended)
QR_SIGNING_SECRET=change_me_qr_hmac_secret_32_bytes_min_______________

# --- Modes ---
SIMULATED_MODE=true

# Provider de cerradura: LOCAL|ESP32|TUYA|SIMULATED
# LOCAL = el ESP32 auto-abre su relé; la API solo registra el evento.
LOCK_PROVIDER=LOCAL

# Caducidad de QR desde BD (sólo true en dev/testing):
#   false (prod, default) = la caducidad la manda el exp firmado dentro del token.
#   true (dev) = la caducidad la manda qr_credentials.expires_at (columna editable).
QR_EXP_FROM_DB=false

# --- WS-VB6 client ---
WSVB6_BASE_URL=http://127.0.0.1:8081/ws-vb6/v1
WSVB6_API_KEY=change_me_wsvb6_api_key

# --- Logging ---
LOG_PATH=logs/api.log
LOG_LEVEL=debug
