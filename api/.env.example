# API environment example (copy to .env and adjust)

APP_ENV=dev
APP_NAME=api
APP_TZ=Europe/Madrid
APP_DEBUG=false

# --- HTTP ---
APP_HTTP_HOST=127.0.0.1
APP_HTTP_PORT=8080
# Comma-separated IPs of TLS-terminating reverse proxies. Empty = trust none.
TRUSTED_PROXY_IPS=

# --- Database (API own schema) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hotel_api
DB_USER=hotel_api
DB_PASS=change_me

# --- Security ---
# HMAC secret for QR tokens (>=32 bytes, base64 or hex recommended)
QR_SIGNING_SECRET=change_me_qr_hmac_secret_32_bytes_min_______________
# F127: cookie firmada del dashboard LAN (si vacío, usa QR_SIGNING_SECRET).
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_TTL_SECONDS=28800

# --- Modes ---
SIMULATED_MODE=true

# Provider de cerradura: LOCAL|ESP32|SIMULATED (Tuya retirado por F122)
# LOCAL = el ESP32 auto-abre su relé; la API solo registra el evento.
LOCK_PROVIDER=LOCAL

# F123: antigüedad máxima de una sesión de trabajador antes de cerrarla como
# AUTO al volver a escanear una llave de acceso (12 h por defecto).
WORKER_SESSION_STALE_SECONDS=43200

# --- Presencia / regla de salida ---
# Guarda de ausencia sostenida (segundos) para confirmar la SALIDA (RF-47.2.4).
# Resolución: rooms.presence_check_seconds (override por sala) > este global > 1.
# La ventana de ENTRADA es independiente: room_types.presence_entry_window_seconds
# (default 90 s). `gap_seconds` en /live queda como campo legacy de compatibilidad.
EXIT_ABSENCE_GUARD_SECONDS=1

# F118.2: si no llega ningún reporte de presencia posterior al cierre en N s,
# se confirma la salida aunque el radar siga viendo el pasillo (0 = desactivar).
EXIT_NO_PRESENCE_AFTER_CLOSE_SECONDS=3

# F118.3: máximo de verificación de salida desde el cierre (segundos).
# Si el radar sigue en PRESENT, la salida se confirma igualmente. 0 = desactivar.
EXIT_MAX_VERIFY_SECONDS=15

# Caducidad de QR desde BD (sólo true en dev/testing):
#   false (prod, default) = la caducidad la manda el exp firmado dentro del token.
#   true (dev) = la caducidad la manda qr_credentials.expires_at (columna editable).
QR_EXP_FROM_DB=false

# --- Ciclo de vida del QR de huésped (Fase 51 / Bug 4) ---
# Ventana de LLEGADA global (minutos), común a todas las habitaciones: el QR es
# válido desde su emisión hasta el PRIMER escaneo. Tras el primer escaneo pasa a
# estado EN USO y es válido durante stays.duracion_minutos (multi-uso/reentrada).
# El token HMAC se sella con exp = emisión + (QR_ARRIVAL_WINDOW_MINUTES + duración).
QR_ARRIVAL_WINDOW_MINUTES=15

# --- WS-VB6 client ---
WSVB6_BASE_URL=http://127.0.0.1:8081/ws-vb6/v1
WSVB6_API_KEY=change_me_wsvb6_api_key

# --- Logging ---
LOG_PATH=logs/api.log
LOG_LEVEL=debug

# --- Directo de cámaras por MJPEG (Fase 70 / RF-80) ---
# URL pública del stream MJPEG (servidor api/bin/cameras-live.js en loopback:8086,
# publicado por Apache). El panel construye mjpeg_url = BASE_URL?id=<device_id>.
# Si se deja vacío, el panel usa el iframe de go2rtc como fallback.
CAMERAS_LIVE_BASE_URL=https://cerraduras.josue.ink/almacen-live
# Parámetros del servidor MJPEG (también configurables en el unit systemd).
CAMERAS_LIVE_PORT=8086
CAMERAS_LIVE_FPS=5
CAMERAS_LIVE_SCALE=640:-2

# --- Tope de duración de grabaciones del almacén (Fase 73 / RF-85) ---
# Máximo de segundos por clip; al alcanzarlo el recorder finaliza el clip como SAVED.
# 0 o ausente = sin límite (producción). En pruebas: 60.
WAREHOUSE_MAX_RECORDING_SECONDS=60

# --- Zigbee2MQTT local consumer (F90; disabled until host/hardware are approved) ---
# The worker is not started automatically. Requires mosquitto_sub only when enabled.
ZIGBEE_MQTT_ENABLED=false
ZIGBEE_MQTT_HOST=127.0.0.1
ZIGBEE_MQTT_PORT=1883
ZIGBEE_MQTT_TOPIC_PREFIX=zigbee2mqtt
ZIGBEE_MQTT_CLIENT_ID=cerraduras-zigbee-consumer
ZIGBEE_MQTT_MAP_FILE=config/zigbee2mqtt-devices.json
ZIGBEE_MQTT_USERNAME=
ZIGBEE_MQTT_PASSWORD_FILE=
ZIGBEE_INGRESS_ENABLED=false
ZIGBEE_SPOOL_ENABLED=false
ZIGBEE_INGRESS_STATUS_FILE=run/zigbee-ingress-status.json
ZIGBEE_SPOOL_DIR=run/zigbee-spool
ZIGBEE_SPOOL_STATUS_FILE=run/zigbee-spool-status.json
ZIGBEE_SPOOL_MAX_AGE_SECONDS=86400
ZIGBEE_SPOOL_MAX_FILES=10000
# F108: maxBytes limita la cola pendiente (incoming+processing), no processed.
ZIGBEE_SPOOL_MAX_BYTES=268435456
ZIGBEE_SPOOL_MIN_FREE_BYTES=67108864
# F125.4: retención de processed/quarantine (0 = no purgar).
ZIGBEE_SPOOL_PROCESSED_RETENTION_DAYS=2
ZIGBEE_SPOOL_QUARANTINE_RETENTION_DAYS=14
# Topics de diagnóstico que no se persisten (separados por coma).
ZIGBEE_INGRESS_DENY_TOPICS=bridge/logging,bridge/health
ZIGBEE_NODE_BIN=node
ZIGBEE_SWITCH_TIMEOUT_SECONDS=5
# F125.4: confirmación del radar por lectura directa MQTT (fallback a BD).
RADAR_DIRECT_CONFIRM_ENABLED=true
RADAR_DIRECT_CONFIRM_TIMEOUT_SECONDS=6
ALMACEN_MOTION_TOKEN=
MOSQUITTO_SUB_BIN=mosquitto_sub

# F105 — medición del radar por punto (interior/exterior)
RADAR_POINT_MIN_SAMPLES=2
RADAR_POINT_TOLERANCE_M=0.30
RADAR_POINT_MAX_ATTEMPTS=3
# F108: la consulta directa dataQuery no se entrega en este firmware.
RADAR_DISTANCE_EVIDENCE_MODE=off
RADAR_DISTANCE_QUERY_ENABLED=false

# F110: ventana interior y semilla de la primera subfase
RADAR_INSIDE_WINDOW_SECONDS=60
RADAR_INSIDE_SEED_MAX_AGE_SECONDS=60

# F110 opción 3: solo DP9 positivos; retención de los antiguos
RADAR_DISTANCE_RETENTION_DAYS=30

# F114+: salida del radar del almacén. La ausencia se confirma por el borde
# DP1 con una gracia corta; no se sondea el dispositivo ni se crea polling.
RADAR_ABSENT_EDGE_GRACE_SECONDS=0.0
# Perfil operativo de calibración del almacén (fading_time corto).
RADAR_WAREHOUSE_FADING_TIME=2.5
# F117: fading corto del radar de la oficina (entrada/salida rápida).
RADAR_TIMBRE_FADING_TIME=2.5
# F114+: borde PRESENT inmediato y ventana de puerta recién abierta.
RADAR_PRESENT_EDGE_MAX_AGE_SECONDS=120
RADAR_MIXED_RECENT_OPEN_SECONDS=10
RADAR_PRESENCE_STALE_SECONDS=30
# F125.2: si el radar reporta una configuración distinta a la guardada, se
# re-aplica sola. Cooldown entre publicaciones y máximo de intentos.
RADAR_RECONCILE_COOLDOWN_SECONDS=3
RADAR_RECONCILE_MAX_ATTEMPTS=6
# F125.4: reportes aplicados consecutivos antes de resetear los intentos.
RADAR_RECONCILE_SETTLE_REPORTS=5
# F125.4: ventana para detectar configuraciones contradictorias en el panel.
RADAR_UNSTABLE_WINDOW_SECONDS=10
# Automatización de luz del almacén (ON con PRESENT/OPEN, OFF con ABSENT).
WAREHOUSE_LIGHT_AUTOMATION=true
# Retardo cancelable del apagado (segundos); exit-scan lo ejecuta.
WAREHOUSE_LIGHT_OFF_DELAY_SECONDS=1
# Ausencia corta sin puerta: se reanuda la misma visita en vez de crear otra.
WAREHOUSE_ABSENT_BLIP_SECONDS=15
