# Copiar a .env (chmod 600) y sustituir TODOS los placeholders.
# .env está ignorado por Git y no debe contener valores reales en el repositorio.

COMPOSE_PROJECT_NAME=zigbee-local

# Imágenes: fijar un tag concreto o un digest. Nunca usar latest.
MOSQUITTO_IMAGE=__REQUIRED_PINNED_MOSQUITTO_IMAGE__
Z2M_IMAGE=__REQUIRED_PINNED_Z2M_IMAGE__

# Publicación SOLO en loopback por defecto.
MQTT_HOST_PORT=1883
Z2M_UI_HOST_PORT=8080

# Credenciales MQTT. Provisionar fuera de Git; el placeholder es inválido.
MQTT_USERNAME=zigbee2mqtt
MQTT_PASSWORD=__REQUIRED_MQTT_PASSWORD__

# Adaptador Zigbee por TCP (Dongle-M). Valores iniciales a validar en banco.
ZIGBEE_ADAPTER_HOST=__REQUIRED_ADAPTER_HOST__
ZIGBEE_ADAPTER_PORT=6638

# Opcionales.
TZ=UTC
MIN_FREE_DISK_MB=2048
MOSQUITTO_CPUS=1.0
MOSQUITTO_MEM_LIMIT=256m
Z2M_CPUS=1.0
Z2M_MEM_LIMIT=512m
