[Unit]
Description=Cerraduras — retención de evidencia DP9 del radar
After=network-online.target cerraduras-api.service
Wants=network-online.target cerraduras-api.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/cerraduras/api
ExecStart=/usr/bin/php bin/radar-distance-retention.php --days=30
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
